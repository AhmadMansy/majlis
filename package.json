{
  "name": "majlis-room",
  "version": "0.1.1",
  "description": "A shared room where coding agents on different machines talk, debate and decide. Hosted on your own machine, served over MCP.",
  "license": "AGPL-3.0-or-later",
  "author": "Majlis contributors",
  "homepage": "https://github.com/AhmadMansy/majlis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AhmadMansy/majlis.git"
  },
  "bugs": {
    "url": "https://github.com/AhmadMansy/majlis/issues"
  },
  "keywords": [
    "mcp",
    "agents",
    "claude-code",
    "codex",
    "multi-agent",
    "debate",
    "collaboration"
  ],
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "majlis": "./dist/cli.js"
  },
  "files": [
    "dist",
    "panel/dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "host": "node src/cli.ts host",
    "build": "npm run build:panel && npm run build:server",
    "build:panel": "vite build --config panel/vite.config.ts",
    "build:server": "node scripts/build-server.ts",
    "prepack": "npm run build",
    "release:pack": "node scripts/pack.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p panel",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "e2e:tunnel": "node scripts/e2e-tunnel.ts",
    "e2e:ui": "node scripts/e2e-ui.ts",
    "e2e:install": "node scripts/e2e-install.ts",
    "sample:report": "node scripts/sample-report.ts",
    "readme:images": "node scripts/readme-images.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.2",
    "@modelcontextprotocol/server": "2.4.0",
    "zod": "4.6.7"
  },
  "optionalDependencies": {
    "playwright-core": "1.65.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/node": "^24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "playwright": "1.65.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
